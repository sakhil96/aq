+  return {
+    month: '',
+    closedOn: '',
+    actor: '',
+    oilTickets: [],
+    gasTickets: [],
+    waterTickets: [],
+    theoreticals: [],
+    ownership: [],
+    prices: {},
+    taxRates: {},
+  };
+}
