+
+  const payable = settlementLines(settlement, 'payableLines');
+  const suspense = settlementLines(settlement, 'suspenseLines');
+  const warnings = [
+    ...(measurements.lines.length === 0 ? ['empty_close'] : []),
+    ...heldWarnings(settlement.lines),
+  ];
+
+  return {
+    ok: true,
+    status: 'closed',
+    month: request.month,
+    closedOn: request.closedOn,
+    actor: request.actor,
+    errors: [],
+    warnings,
+    measurementLines: measurements.lines,
+    controls: measurements.controls,
+    allocations: allocations.lines,
+    allocationControls: allocations.controls,
+    ownerLines: settlement.lines,
+    owners: settlement.owners,
+    payable,
+    suspense,
+    snapshots: artifacts.snapshots,
+    journal: artifacts.journalLines,
+    reports: {
+      wells: artifacts.wellSummaries,
+      owners: artifacts.ownerSummaries,
+    },
+    totals: {
+      measurements: measurements.totals,
+      allocations: allocations.totals,
+      settlement: settlement.totals,
+    },
+  };
+}
