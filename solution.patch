+}
+
+function settlementLines(result, key) {
+  const rows = result && result[key];
+  return Array.isArray(rows) ? rows : [];
+}
+
+/**
+ * Run measurement, allocation, DOI settlement, reporting, and audit creation
+ * as one deterministic month-end close.
+ */
+export function closeProductionMonth(input) {
+  const request = normalizeCloseRequest(input);
