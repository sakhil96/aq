+    ok: false,
+    status: 'rejected',
+    month: request.month || '',
+    closedOn: request.closedOn || '',
+    actor: request.actor || '',
+    errors,
+    warnings: [],
+    measurementLines: [],
+    controls: [],
+    allocations: [],
+    allocationControls: [],
+    ownerLines: [],
+    owners: [],
+    payable: [],
+    suspense: [],
+    snapshots: [],
+    journal: [],
+    reports: emptyReports(),
+    totals: {
+      measurements: zeroVolumeTotals(),
+      allocations: zeroVolumeTotals(),
+      settlement: zeroMoneyTotals(),
+    },
+  };
+}
+
+function heldWarnings(lines) {
+  const owners = (Array.isArray(lines) ? lines : [])
+    .filter((line) => line && line.status === 'hold')
+    .map((line) => asTrimmed(line.owner))
