+  const gas = arrayInput(input, 'gasTickets', ['gas']);
+  const water = arrayInput(input, 'waterTickets', ['water']);
+  const theoreticals = arrayInput(input, 'theoreticals');
+  const ownership = arrayInput(input, 'ownership', ['doi']);
