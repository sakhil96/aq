+        : signedRoundedInteger(volume * (10 ** VOLUME_PLACES));
+      const grossMills = volume === null
+        ? null
+        : signedRoundedInteger(volume * price * 1000);
+      const taxMills = grossMills === null
+        ? null
+        : signedRoundedInteger(grossMills * taxRate);
+      if (volumeUnits === null || grossMills === null || taxMills === null) {
+        errors.push(`settlement_overflow:${well.well}:${product}`);
+        continue;
+      }
+      const volumes = distributeInteger(volumeUnits, doi.owners);
+      const gross = distributeInteger(grossMills, doi.owners);
+      const taxAllocation = distributeCappedInteger(taxMills, doi.owners, gross);
+      if (!taxAllocation.ok) {
+        errors.push(`settlement_overflow:${well.well}:${product}`);
+        continue;
+      }
+      const tax = taxAllocation.values;
+
+      for (let index = 0; index < doi.owners.length; index += 1) {
+        const owner = doi.owners[index];
+        const ownerGross = gross[index];
+        const ownerTax = tax[index];
+        const ownerNet = ownerGross - ownerTax;
+        const payable = owner.pay ? ownerNet : 0;
+        const suspense = owner.pay ? 0 : ownerNet;
+        lines.push({
+          owner: owner.owner,
+          well: well.well,
+          product,
+          decimal: owner.decimal,
+          volume: roundTo(volumes[index] / (10 ** VOLUME_PLACES), VOLUME_PLACES),
+          price,
+          gross: moneyFromMills(ownerGross),
+          tax: moneyFromMills(ownerTax),
+          net: moneyFromMills(ownerNet),
+          status: owner.pay ? "pay" : "hold",
+          payable: moneyFromMills(payable),
+          suspense: moneyFromMills(suspense),
+        });
+      }
+    }
+  }
+
+  lines.sort(compareLines);
+  const owners = ownerRollups(lines, errors);
+  const totals = settlementTotals(lines, errors);
+  const stableErrors = [...new Set(errors)].sort((a, b) => a.localeCompare(b));
+  return {
+    ok: stableErrors.length === 0,
+    month: ym,
+    lines,
+    owners,
+    payableLines: lines.filter((line) => line.status === "pay"),
+    suspenseLines: lines.filter((line) => line.status === "hold"),
+    totals,
+    errors: stableErrors,
+  };
+}
