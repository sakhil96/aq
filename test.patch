+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import * as api from '../../src/index.js';
+
+const MONTH = '2024-02';
+
+function assertFields(actual, expected) {
+  assert.ok(actual && typeof actual === 'object');
+  for (const [key, value] of Object.entries(expected)) {
+    assert.deepEqual(actual[key], value, `unexpected ${key}`);
+  }
+}
+
+function keyed(rows, keyOf) {
+  const result = new Map();
+  for (const row of rows) {
+    const key = keyOf(row);
+    assert.equal(result.has(key), false, `duplicate row key ${key}`);
+    result.set(key, row);
+  }
+  return result;
+}
+
+function assertHasErrors(result) {
+  assert.equal(result.ok, false);
+  assert.ok(Array.isArray(result.errors), 'errors must be an array');
+  assert.ok(result.errors.length > 0, 'errors must describe the rejected input');
+}
+
+function assertErrorsMention(result, ...values) {
+  assertHasErrors(result);
+  const description = result.errors.map((error) => (
+    typeof error === 'string' ? error : JSON.stringify(error)
+  )).join(' ').toLowerCase();
+  for (const value of values) {
+    assert.ok(
+      description.includes(String(value).toLowerCase()),
+      `errors must identify ${value}`,
+    );
+  }
+}
+
+function assertNear(actual, expected, tolerance = 0.001) {
+  assert.ok(
+    Math.abs(actual - expected) <= tolerance,
+    `expected ${actual} to be within ${tolerance} of ${expected}`,
+  );
+}
+
+function decimalPlaces(value) {
+  const [, fraction = ''] = String(value).split('.');
+  return fraction.length;
+}
+
+function oilTicket(overrides = {}) {
+  return {
+    id: 'O-1',
+    battery: 'BAT-1',
+    gaugeDate: '2024-02-10',
+    gross: 100,
+    bswPct: 2,
+    api: 40,
+    tempF: 60,
+    ...overrides,
+  };
+}
+
+function gasTicket(overrides = {}) {
+  return {
+    id: 'G-1',
+    battery: 'BAT-1',
+    startOn: '2024-02-01',
+    endOn: '2024-02-29',
+    mcf: 100,
+    btu: 1100,
+    co2Pct: 5,
+    n2Pct: 5,
+    wetDry: 'wet',
+    ...overrides,
+  };
+}
+
+function waterTicket(overrides = {}) {
+  return {
+    id: 'H-1',
+    battery: 'BAT-1',
+    hauledOn: '2024-02-15',
+    bbl: 30,
+    direction: 'out',
+    ...overrides,
+  };
+}
+
+function groundTicketPayload() {
+  return {
+    oilTickets: [oilTicket()],
+    gasTickets: [gasTicket()],
+    waterTickets: [waterTicket()],
+  };
+}
+
+function groundTheoreticals() {
+  return [
+    {
+      id: 'T-W1',
+      well: 'W1',
+      battery: 'BAT-1',
+      monthOn: '2024-02-01',
+      oil: 3,
+      gas: 1,
+      water: 2,
+    },
+    {
+      id: 'T-W2',
+      well: 'W2',
+      battery: 'BAT-1',
+      monthOn: '2024-02-01',
+      oil: 1,
+      gas: 3,
+      water: 1,
+    },
+  ];
+}
+
+function groundOwnership() {
+  return [
+    { property: 'W1', owner: 'A', decimal: 0.75, payStatus: 'pay' },
+    { property: 'W1', owner: 'B', decimal: 0.25, payStatus: 'hold' },
+    { property: 'W2', owner: 'A', decimal: 0.5, payStatus: 'pay' },
+    { property: 'W2', owner: 'C', decimal: 0.5, payStatus: 'pay' },
+  ];
+}
+
+function groundMeasurements() {
+  return api.collectCloseMeasurements(MONTH, groundTicketPayload());
+}
+
+function groundAllocations() {
+  return api.allocateCloseVolumes(MONTH, groundMeasurements(), groundTheoreticals());
+}
+
+test('close measurements convert oil, wet gas, and hauled water into controls', () => {
+  const result = api.collectCloseMeasurements(MONTH, groundTicketPayload());
+
+  assert.equal(result.ok, true);
+  assert.equal(result.month, MONTH);
+  assert.deepEqual(result.errors, []);
+  assertFields(result.totals, {
+    oilBbl: 98,
+    gasMcf: 90,
+    gasMmbtu: 99,
+    waterBbl: 30,
+  });
+  assert.equal(result.lines.length, 3);
+  const lines = keyed(result.lines, (line) => line.id);
+  assertFields(lines.get('O-1'), {
+    id: 'O-1', product: 'oil', battery: 'BAT-1',
+    oilBbl: 98, gasMcf: 0, gasMmbtu: 0, waterBbl: 0,
+  });
+  assertFields(lines.get('G-1'), {
+    id: 'G-1', product: 'gas', battery: 'BAT-1',
+    oilBbl: 0, gasMcf: 90, gasMmbtu: 99, waterBbl: 0,
+  });
+  assertFields(lines.get('H-1'), {
+    id: 'H-1', product: 'water', battery: 'BAT-1',
+    oilBbl: 0, gasMcf: 0, gasMmbtu: 0, waterBbl: 30,
+  });
+  assert.ok(result.lines.every((line) => (
+    typeof line.occurredOn === 'string' && line.occurredOn.startsWith(MONTH)
+  )));
+  assert.equal(result.controls.length, 1);
+  assertFields(result.controls[0], {
+    battery: 'BAT-1',
+    ticketCount: 3,
+    oilTickets: 1,
+    gasTickets: 1,
+    waterTickets: 1,
+    oilBbl: 98,
+    gasMcf: 90,
+    gasMmbtu: 99,
+    waterBbl: 30,
+  });
+});
+
+test('close measurements honor leap-month boundaries and ignore neighboring months', () => {
