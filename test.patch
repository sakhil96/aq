+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import * as api from '../../src/index.js';
+
+const MONTH = '2024-02';
+
+function closeRequest(overrides = {}) {
+  return {
+    month: MONTH,
+    actor: 'closer',
+    oilTickets: [{
+      id: 'O-1',
+      battery: 'BAT-1',
+      gaugeDate: '2024-02-10',
+      gross: 100,
+      bswPct: 2,
+      api: 40,
+      tempF: 60,
+    }],
+    gasTickets: [{
+      id: 'G-1',
+      battery: 'BAT-1',
+      startOn: '2024-02-01',
+      endOn: '2024-02-29',
+      mcf: 100,
+      btu: 1100,
+      co2Pct: 5,
+      n2Pct: 5,
+      wetDry: 'wet',
+    }],
+    waterTickets: [{
+      id: 'H-1',
+      battery: 'BAT-1',
+      hauledOn: '2024-02-15',
+      bbl: 30,
+      direction: 'out',
+    }],
+    theoreticals: [
+      {
+        id: 'T-W1',
+        well: 'W1',
+        battery: 'BAT-1',
+        monthOn: '2024-02-01',
+        oil: 3,
+        gas: 1,
+        water: 2,
+      },
+      {
+        id: 'T-W2',
+        well: 'W2',
+        battery: 'BAT-1',
+        monthOn: '2024-02-01',
+        oil: 1,
+        gas: 3,
+        water: 1,
+      },
+    ],
+    ownership: [
+      { property: 'W1', owner: 'A', decimal: 0.75, payStatus: 'pay' },
+      { property: 'W1', owner: 'B', decimal: 0.25, payStatus: 'hold' },
+      { property: 'W2', owner: 'A', decimal: 0.5, payStatus: 'pay' },
+      { property: 'W2', owner: 'C', decimal: 0.5, payStatus: 'pay' },
+    ],
+    prices: { oil: 70, gas: 3 },
+    taxRates: { oil: 0.05, gas: 0.1 },
+    ...overrides,
+  };
+}
+
+function completedStages() {
+  const request = closeRequest();
+  const measurements = api.collectCloseMeasurements(MONTH, request);
+  const allocations = api.allocateCloseVolumes(MONTH, measurements, request.theoreticals);
+  const settlement = api.settleCloseOwners(
+    MONTH,
+    allocations,
+    request.ownership,
+    request.prices,
+    request.taxRates,
+  );
+  return { request, measurements, allocations, settlement };
+}
+
+function assertFields(actual, expected) {
+  for (const [key, value] of Object.entries(expected)) {
+    assert.deepEqual(actual[key], value, `${key} differs`);
+  }
+}
+
+function assertNear(actual, expected, tolerance = 0.001) {
+  assert.ok(
+    Math.abs(actual - expected) <= tolerance,
+    `expected ${actual} to be within ${tolerance} of ${expected}`,
+  );
+}
+
+function assertHasErrors(result) {
+  assert.equal(result.ok, false);
+  assert.ok(Array.isArray(result.errors), 'errors must be an array');
+  assert.ok(result.errors.length > 0, 'errors must describe the rejected input');
+}
+
+function sorted(values) {
