+
+  assert.equal(result.ok, true);
+  assert.equal(result.totals.waterBbl, 23);
+  assert.deepEqual(
+    Object.fromEntries(result.lines.map((line) => [line.id, line.waterBbl])),
+    { 'IN': -5, 'IN-ALIAS': -2, 'OUT': 30 },
+  );
+  assert.equal(result.controls[0].waterTickets, 3);
+  assert.equal(result.controls[0].ticketCount, 3);
+});
+
+test('close measurements scope duplicate detection by product and target month', () => {
+  const result = api.collectCloseMeasurements(MONTH, {
+    oilTickets: [
+      oilTicket({ id: 'SHARED' }),
+      oilTicket({ id: 'OLD', gaugeDate: '2024-01-10' }),
+      oilTicket({ id: 'OLD', gaugeDate: '2024-01-11' }),
+    ],
+    gasTickets: [gasTicket({ id: 'SHARED' })],
+    waterTickets: [waterTicket({ id: 'SHARED' })],
+  });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.errors, []);
+  assert.deepEqual(result.lines.map((line) => `${line.product}:${line.id}`), [
+    'oil:SHARED',
+    'gas:SHARED',
+    'water:SHARED',
+  ]);
+
+  const duplicate = api.collectCloseMeasurements(MONTH, {
+    oilTickets: [oilTicket({ id: 'DUP' }), oilTicket({ id: 'DUP', gross: 25 })],
+  });
+  assert.equal(duplicate.ok, false);
+  assert.deepEqual(duplicate.errors, ['duplicate_ticket:oil:DUP']);
+  assert.deepEqual(duplicate.lines, []);
+  assert.equal(duplicate.totals.oilBbl, 0);
+});
+
