+
+test('close measurements retain valid rows while reporting bad tickets and locations', () => {
+  const result = api.collectCloseMeasurements(MONTH, {
+    oilTickets: [
+      oilTicket({ id: 'GOOD' }),
+      oilTicket({ id: 'NEG', gross: -1 }),
