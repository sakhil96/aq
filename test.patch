+      oilTicket({ id: 'FIRST', gaugeDate: '2024-02-01', gross: 20, bswPct: 0 }),
+      oilTicket({ id: 'LAST', gaugeDate: '2024-02-29', gross: 30, bswPct: 0 }),
+      oilTicket({ id: 'MAR', gaugeDate: '2024-03-01', gross: 40 }),
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.month, '2024-02');
+  const lines = keyed(result.lines, (line) => line.id);
+  assert.deepEqual(new Set(lines.keys()), new Set(['FIRST', 'LAST']));
+  assert.ok([...lines.values()].every((line) => line.occurredOn.startsWith(MONTH)));
+  assert.equal(result.controls[0].ticketCount, 2);
+  assert.equal(result.controls[0].oilTickets, 2);
