+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import * as api from '../../src/index.js';
+
+const MONTH = '2024-02';
+
+function oilTicket(overrides = {}) {
+  return {
+    id: 'O-1',
+    battery: 'BAT-1',
+    gaugeDate: '2024-02-10',
+    gross: 100,
+    bswPct: 2,
+    api: 40,
+    tempF: 60,
+    ...overrides,
+  };
+}
+
+function gasTicket(overrides = {}) {
+  return {
+    id: 'G-1',
+    battery: 'BAT-1',
+    startOn: '2024-02-01',
+    endOn: '2024-02-29',
+    mcf: 100,
+    btu: 1100,
+    co2Pct: 5,
+    n2Pct: 5,
+    wetDry: 'wet',
+    ...overrides,
+  };
+}
+
+function waterTicket(overrides = {}) {
+  return {
+    id: 'H-1',
+    battery: 'BAT-1',
+    hauledOn: '2024-02-15',
+    bbl: 30,
+    direction: 'out',
+    ...overrides,
+  };
+}
+
+function groundTicketPayload() {
+  return {
+    oilTickets: [oilTicket()],
+    gasTickets: [gasTicket()],
+    waterTickets: [waterTicket()],
+  };
+}
+
+function groundTheoreticals() {
+  return [
+    {
+      id: 'T-W1',
+      well: 'W1',
+      battery: 'BAT-1',
+      monthOn: '2024-02-01',
+      oil: 3,
+      gas: 1,
+      water: 2,
+    },
+    {
+      id: 'T-W2',
+      well: 'W2',
+      battery: 'BAT-1',
+      monthOn: '2024-02-01',
+      oil: 1,
+      gas: 3,
+      water: 1,
+    },
+  ];
+}
+
+function groundOwnership() {
+  return [
+    { property: 'W1', owner: 'A', decimal: 0.75, payStatus: 'pay' },
+    { property: 'W1', owner: 'B', decimal: 0.25, payStatus: 'hold' },
+    { property: 'W2', owner: 'A', decimal: 0.5, payStatus: 'pay' },
+    { property: 'W2', owner: 'C', decimal: 0.5, payStatus: 'pay' },
+  ];
+}
+
+function groundMeasurements() {
+  return api.collectCloseMeasurements(MONTH, groundTicketPayload());
+}
+
+function groundAllocations() {
+  return api.allocateCloseVolumes(MONTH, groundMeasurements(), groundTheoreticals());
+}
+
+test('close measurements convert oil, wet gas, and hauled water into controls', () => {
+  const result = api.collectCloseMeasurements(MONTH, groundTicketPayload());
+
+  assert.equal(result.ok, true);
+  assert.equal(result.month, MONTH);
+  assert.deepEqual(result.errors, []);
+  assert.deepEqual(result.totals, {
+    oilBbl: 98,
+    gasMcf: 90,
+    gasMmbtu: 99,
+    waterBbl: 30,
+  });
+  assert.deepEqual(result.lines, [
+    {
+      id: 'O-1',
+      product: 'oil',
+      battery: 'BAT-1',
+      occurredOn: '2024-02-10',
+      oilBbl: 98,
+      gasMcf: 0,
+      gasMmbtu: 0,
+      waterBbl: 0,
+    },
+    {
+      id: 'G-1',
+      product: 'gas',
+      battery: 'BAT-1',
+      occurredOn: '2024-02-29',
+      oilBbl: 0,
+      gasMcf: 90,
+      gasMmbtu: 99,
+      waterBbl: 0,
+    },
+    {
+      id: 'H-1',
+      product: 'water',
+      battery: 'BAT-1',
+      occurredOn: '2024-02-15',
+      oilBbl: 0,
+      gasMcf: 0,
+      gasMmbtu: 0,
+      waterBbl: 30,
+    },
+  ]);
+  assert.deepEqual(result.controls, [{
+    battery: 'BAT-1',
+    ticketCount: 3,
+    oilTickets: 1,
+    gasTickets: 1,
+    waterTickets: 1,
+    oilBbl: 98,
+    gasMcf: 90,
+    gasMmbtu: 99,
+    waterBbl: 30,
+  }]);
+});
+
+test('close measurements honor leap-month boundaries and ignore neighboring months', () => {
+  const result = api.collectCloseMeasurements(MONTH, {
+    oilTickets: [
+      oilTicket({ id: 'JAN', gaugeDate: '2024-01-31', gross: 10 }),
+      oilTicket({ id: 'FIRST', gaugeDate: '2024-02-01', gross: 20, bswPct: 0 }),
+      oilTicket({ id: 'LAST', gaugeDate: '2024-02-29', gross: 30, bswPct: 0 }),
+      oilTicket({ id: 'MAR', gaugeDate: '2024-03-01', gross: 40 }),
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.month, '2024-02');
+  assert.deepEqual(result.lines.map((line) => line.id), ['FIRST', 'LAST']);
+  assert.deepEqual(result.lines.map((line) => line.occurredOn), [
+    '2024-02-01',
+    '2024-02-29',
+  ]);
+  assert.equal(result.controls[0].ticketCount, 2);
+  assert.equal(result.controls[0].oilTickets, 2);
+  assert.equal(result.totals.oilBbl, 50);
+});
+
+test('close measurements canonicalize a day input and accept collection aliases', () => {
+  const result = api.collectCloseMeasurements('2024-02-18', {
+    oil: [oilTicket()],
+    gas: [gasTicket()],
+    water: [waterTicket()],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.month, MONTH);
+  assert.equal(result.lines.length, 3);
+  assert.deepEqual(result.lines.map((line) => line.product), [
+    'oil',
+    'gas',
+    'water',
+  ]);
+  assert.deepEqual(result.totals, {
+    oilBbl: 98,
+    gasMcf: 90,
+    gasMmbtu: 99,
+    waterBbl: 30,
+  });
+});
+
+test('close measurements resolve product-specific battery fallbacks', () => {
+  const oil = oilTicket({ battery: undefined, tank: 'TANK-9', well: 'OW-1' });
+  const gas = gasTicket({ battery: undefined, station: 'ST-2', meter: 'MTR-2' });
+  const water = waterTicket({ battery: undefined, disposal: 'DISP-4', fromWell: 'WW-4' });
+  const result = api.collectCloseMeasurements(MONTH, {
+    oilTickets: [oil],
+    gasTickets: [gas],
+    waterTickets: [water],
+  });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.lines.map((line) => [line.product, line.battery]), [
+    ['water', 'DISP-4'],
+    ['gas', 'ST-2'],
+    ['oil', 'TANK-9'],
+  ]);
+  assert.deepEqual(result.controls.map((control) => control.battery), [
+    'DISP-4',
+    'ST-2',
+    'TANK-9',
+  ]);
+});
+
+test('close measurements subtract water receipts from hauled production', () => {
+  const result = api.collectCloseMeasurements(MONTH, {
+    waterTickets: [
+      waterTicket({ id: 'OUT', bbl: 30, direction: 'out' }),
+      waterTicket({ id: 'IN', bbl: 5, direction: 'receipt' }),
+      waterTicket({ id: 'IN-ALIAS', bbl: 2, direction: 'in' }),
