+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.errors, []);
+  assertFields(result.totals, measured.totals);
+  assert.equal(result.lines.length, 2);
+  const lines = keyed(result.lines, (line) => line.well);
+  assertFields(lines.get('W1'), {
+    month: MONTH, battery: 'BAT-1', well: 'W1',
+    oilFactor: 3, gasFactor: 1, waterFactor: 2,
+    oilBbl: 73.5, gasMcf: 22.5, gasMmbtu: 24.75, waterBbl: 20,
+  });
+  assertFields(lines.get('W2'), {
+    month: MONTH, battery: 'BAT-1', well: 'W2',
+    oilFactor: 1, gasFactor: 3, waterFactor: 1,
+    oilBbl: 24.5, gasMcf: 67.5, gasMmbtu: 74.25, waterBbl: 10,
+  });
+  assert.ok(lines.get('W1').id);
+  assert.ok(lines.get('W2').id);
+  assert.equal(result.controls.length, 1);
+  assert.equal(result.controls[0].battery, 'BAT-1');
+  assertFields(result.controls[0].measured, measured.totals);
+  assertFields(result.controls[0].allocated, measured.totals);
+  assertFields(result.controls[0].residual, {
+    oilBbl: 0, gasMcf: 0, gasMmbtu: 0, waterBbl: 0,
+  });
+});
